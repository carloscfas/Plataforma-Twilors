# Django Settings
SECRET_KEY=seu-secret-key-aqui-mude-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database PostgreSQL (local)
DATABASE_NAME=twilors_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis (WebSockets/Channels)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
EMAIL_USE_TLS=True

# AWS S3 (opcional, para uploads)
AWS_ACCESS_KEY_ID=sua-chave-aws
AWS_SECRET_ACCESS_KEY=sua-secret-aws
AWS_STORAGE_BUCKET_NAME=seu-bucket-s3
AWS_S3_REGION_NAME=us-east-1

# Google OAuth
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=seu-facebook-app-id
FACEBOOK_APP_SECRET=seu-facebook-app-secret

# Apple OAuth
APPLE_CLIENT_ID=seu-apple-client-id
APPLE_TEAM_ID=seu-apple-team-id
APPLE_KEY_ID=seu-apple-key-id
APPLE_PRIVATE_KEY=sua-apple-private-key

# App Settings
ENVIRONMENT=development
